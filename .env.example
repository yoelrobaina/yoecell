# Variables de entorno del servidor. NO se suben al repositorio ni se usan en el frontend.
# Cópialas a .env.local (Vercel: Project > Settings > Environment Variables).

# Contraseña del panel de administración (obligatoria en producción).
# Alternativa más segura: genera un hash con
#   node -e "import('./api/_lib/auth.js').then(m=>console.log(m.hashPassword('TU_CONTRASENA')))"
# y guarda el resultado en ADMIN_PASSWORD_HASH.
ADMIN_PASSWORD=pon-aqui-tu-contrasena-larga

# Secreto para firmar la cookie de sesión (mínimo 16 caracteres, se recomienda 32+).
# Genera uno con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=pon-aqui-un-secreto-aleatorio-de-32-caracteres

# Persistencia del catálogo en Vercel (opcional pero recomendado).
# Con estos datos cada guardado del panel se convierte en un commit en GitHub.
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx
GITHUB_REPO=tu-usuario/tu-repositorio
GITHUB_BRANCH=main

# Puerto del servidor local (opcional).
PORT=3000
